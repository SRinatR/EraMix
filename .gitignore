node_modules/
.pnpm-store/
dist/
build/
.next/
.turbo/
coverage/
*.tsbuildinfo
.env
.env.*
!.env.example
# Explicit, defense-in-depth call-outs (ADR-0016) — already matched by
# `.env.*` above, named here so a future edit to that broader pattern can't
# silently stop covering dotenvx's private-decryption-key files.
.env.keys
.env.*.keys
*.log
.DS_Store
Thumbs.db

# Dev-only local media storage (MEDIA_STORAGE_DIR default —
# packages/infrastructure/src/local-storage-provider.ts); never the real
# object-storage provider (ADR-0006, blocked on Q-06).
.var/

# Generated Prisma Client (packages/infrastructure/prisma/schema.prisma
# generator output); regenerated by `pnpm --filter @eramix/infrastructure run db:generate`.
packages/infrastructure/src/generated/

# Pi-only Playwright E2E suite (e2e/README.md) — deliberately outside the
# pnpm workspace; installed/run only on the authorized Pi session, never here.
/e2e/test-results/
/e2e/playwright-report/
/e2e/.cache/

# Generated QA proofing renders of docs/*.docx (PDF/PNG snapshots produced
# while editing the spec) and the one-off docx-editing/inspection scripts
# used to produce them. Not product source; regenerable from the docx and
# python-docx if ever needed again. Re-track deliberately if these become
# maintained tooling rather than one-time editing aids.
/qa/
/tools/
