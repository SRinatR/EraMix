// EraMix persistence model — Phase 1.
//
// Design notes (not restated per-model below):
// - Every id is an internal UUID; public-facing identifiers (`publicId`,
//   `orderNumber`) are separate, immutable, opaque columns generated by
//   packages/domain — never a concatenated `id-slug` value (CLAUDE.md).
// - `*Translation` tables are unique per (parentId, locale) (DB-007/DB-008).
// - Route tables enforce exactly one canonical route per translation via a
//   partial unique index added in migration.sql (Prisma has no first-class
//   partial-unique-index attribute), and route uniqueness per (namespace,
//   locale, slug) or (locale, slug) — a route is unique within its own
//   namespace and locale, not globally (CLAUDE.md).
// - `version` columns back optimistic concurrency (incremented by the
//   repository adapter on every update; a `WHERE version = $expected` guard
//   yields the CONCURRENCY_CONFLICT domain error on 0 rows affected).
// - Article/Page/FAQ share one generic Content/ContentTranslation/
//   ContentRoute model (TZ Appendix F.3 explicitly allows either duplicating
//   the Article-shaped model per type or "a common typed registry with full
//   foreign keys" — chosen here because Article/Page/FAQ are structurally
//   identical). Category keeps its own model because it additionally carries
//   a parent/child hierarchy and lives in the `catalog` route namespace
//   shared with Product, not the `articles`/`pages` namespaces.
// - Company's exact required legal/registration fields are an open business
//   decision (TZ intro: "Обязательные реквизиты компании... требуют
//   бизнес-утверждения до Sprint 1", not yet a numbered Q- item) — modeled as
//   an untyped `metadata` bucket rather than invented structured columns; see
//   docs/OPEN_QUESTIONS.md Q-09.
// - Order/OrderLine intentionally carry no price/tax/total column per
//   ADR-0005 (hybrid indicative pricing, quote-only order workflow).

// Prisma 7: the connection URL lives in prisma.config.ts (datasource.url),
// not here; the client generator requires an explicit `output` path (no
// implicit node_modules generation) and PrismaClient requires an explicit
// driver adapter (@prisma/adapter-pg) — see src/prisma-client.ts.
generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  runtime       = "nodejs"
  moduleFormat  = "esm"
  // "native" keeps local dev (Windows/macOS/glibc Linux) working;
  // linux-musl-openssl-3.0.x is required for the Alpine-based container
  // images (infra/docker/*.Dockerfile) — untested against a real container
  // build on this laptop (no Docker here per policy), to be verified in the
  // authorized Pi/Docker session.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Locale {
  en
  ru
  uz
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  ARTICLE
  PAGE
  FAQ_ITEM
}

/// Route namespace a ContentRoute belongs to. Category and Product are not
/// included here: Category has its own CategoryRoute, and Product resolves
/// by publicId rather than a route table (ADR-0010).
enum ContentRouteNamespace {
  ARTICLES
  PAGES
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// Platform-wide staff/customer role — see ADR-0014 (grounded in TZ §3.1's
/// RBAC matrix: Клиент/Менеджер/Редактор/Администратор + Auditor). Distinct
/// from CompanyRole, which is company-scoped (OWNER/MEMBER within one
/// Membership row).
enum PlatformRole {
  CUSTOMER
  MANAGER
  CONTENT_EDITOR
  ADMIN
  AUDITOR
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

/// Company-scoped role. The full platform RBAC permission model is Phase 4
/// (docs/IMPLEMENTATION_ROADMAP.md); this is the minimal structural role
/// needed for a Membership row to exist in Phase 1.
enum CompanyRole {
  OWNER
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REVOKED
}

/// See ADR-0005. Currently one mode; the enum exists so a future mode can be
/// added without a breaking migration.
enum PriceDisplayMode {
  FROM_PRICE_INDICATIVE
}

enum ProductAssetType {
  IMAGE
  DOCUMENT
}

/// Only ever persisted as CLEAN — an INFECTED result is rejected before a
/// ProductAsset row is ever created (mirrors packages/application/src/
/// uploads.ts's "never call storage.put on a failed scan"). The enum still
/// names INFECTED so the historical/audit trail vocabulary is complete, and
/// so a future async re-scan pipeline has a place to write a changed result.
enum MalwareScanStatus {
  CLEAN
  INFECTED
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  WAITING_CONFIRMATION
  CONFIRMED
  IN_PREPARATION
  READY_FOR_PICKUP
  READY_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

/// PUBLIC comments are visible to the ordering company's own members
/// (ORD-008: "клиент видит... публичные комментарии менеджера"); INTERNAL
/// comments are visible only to actors holding `order.transition`
/// (manager/admin) — see packages/application/src/order-comments.ts.
enum CommentVisibility {
  PUBLIC
  INTERNAL
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD_LETTER
}

// ---------- Identity & company ----------
// (PlatformSettings/PlatformSettingsHistory enums and models are declared
// after User/Company/Membership, near the end of the file, since they carry
// no relation to the identity/catalog/order model tree.)

model User {
  id           String       @id @default(uuid()) @db.Uuid
  issuer       String       @db.VarChar(255)
  subject      String       @db.VarChar(255)
  email        String       @db.VarChar(320)
  displayName  String       @db.VarChar(255)
  status       UserStatus   @default(ACTIVE)
  /// See ADR-0014. Defaults to CUSTOMER; promotion to staff roles is an
  /// explicit admin `users.manage` action, never inferred from an OIDC claim.
  platformRole PlatformRole @default(CUSTOMER)

  memberships             Membership[]
  createdOrders           Order[]                   @relation("OrderCreatedBy")
  orderStatusEvents       OrderStatusHistory[]
  orderComments           OrderComment[]            @relation("OrderCommentAuthor")
  auditEvents             AuditEvent[]
  uploadedProductAssets   ProductAsset[]
  platformSettingsChanges PlatformSettingsHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(0)

  @@unique([issuer, subject])
  @@index([email])
  @@map("users")
}

model Company {
  id        String        @id @default(uuid()) @db.Uuid
  legalName String        @db.VarChar(255)
  status    CompanyStatus @default(ACTIVE)
  /// Untyped bucket for jurisdiction-specific registration fields pending a
  /// business decision — see docs/OPEN_QUESTIONS.md Q-09.
  metadata  Json?

  memberships Membership[]
  orders      Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(0)

  @@map("companies")
}

model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  companyId String           @db.Uuid
  role      CompanyRole      @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(0)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("memberships")
}

// ---------- Content: Article / Page / FAQ ----------

model Content {
  id               String            @id @default(uuid()) @db.Uuid
  type             ContentType
  status           PublicationStatus @default(DRAFT)
  publishedAt      DateTime?
  /// Durable, one-way "permanently retired" state (CLAUDE.md: HTTP 410 only
  /// for this, never merely-unpublished) — see the manual CHECK constraint
  /// in migration.sql tying retiredAt to status = ARCHIVED.
  retiredAt        DateTime?
  retirementReason String?

  translations ContentTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(0)

  @@index([type, status])
  @@map("contents")
}

model ContentTranslation {
  id             String  @id @default(uuid()) @db.Uuid
  contentId      String  @db.Uuid
  locale         Locale
  title          String  @db.VarChar(255)
  summary        String?
  /// Rich body content (e.g. block-based document JSON); rendering policy is
  /// Phase 3.
  content        Json
  seoTitle       String? @db.VarChar(255)
  seoDescription String? @db.VarChar(500)

  contentRef Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)
  routes     ContentRoute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Backs optimistic concurrency for the translation-edit use case (editing
  /// title/summary/content/SEO fields never touches the parent Content's own
  /// `version`, which is reserved for status transitions — see
  /// packages/application/src/translation-edit.ts).
  version   Int      @default(0)

  @@unique([contentId, locale])
  @@unique([id, locale])
  @@map("content_translations")
}

model ContentRoute {
  id            String                @id @default(uuid()) @db.Uuid
  translationId String                @db.Uuid
  locale        Locale
  namespace     ContentRouteNamespace
  slug          String                @db.VarChar(180)
  /// Exactly one TRUE row per translationId, enforced by a partial unique
  /// index in migration.sql (`content_route_one_canonical`).
  isCanonical   Boolean               @default(false)

  translation ContentTranslation @relation(fields: [translationId, locale], references: [id, locale], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([namespace, locale, slug])
  @@index([translationId, isCanonical])
  @@map("content_routes")
}

// ---------- Catalog: Category / Product ----------

model Category {
  id               String            @id @default(uuid()) @db.Uuid
  parentId         String?           @db.Uuid
  status           PublicationStatus @default(DRAFT)
  sortOrder        Int               @default(0)
  /// Durable, one-way "permanently retired" state — see Content.retiredAt.
  retiredAt        DateTime?
  retirementReason String?

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")

  translations CategoryTranslation[]
  products     Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(0)

  @@index([parentId])
  @@map("categories")
}

model CategoryTranslation {
  id             String  @id @default(uuid()) @db.Uuid
  categoryId     String  @db.Uuid
  locale         Locale
  name           String  @db.VarChar(255)
  seoTitle       String? @db.VarChar(255)
  seoDescription String? @db.VarChar(500)

  category Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  routes   CategoryRoute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Backs optimistic concurrency for the translation-edit use case — see
  /// the matching comment on ContentTranslation.version.
  version   Int      @default(0)

  @@unique([categoryId, locale])
  @@unique([id, locale])
  @@map("category_translations")
}

model CategoryRoute {
  id            String  @id @default(uuid()) @db.Uuid
  translationId String  @db.Uuid
  locale        Locale
  slug          String  @db.VarChar(180)
  /// Exactly one TRUE row per translationId, enforced by a partial unique
  /// index in migration.sql (`category_route_one_canonical`).
  isCanonical   Boolean @default(false)

  translation CategoryTranslation @relation(fields: [translationId, locale], references: [id, locale], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([locale, slug])
  @@index([translationId, isCanonical])
  @@map("category_routes")
}

model Product {
  id               String            @id @default(uuid()) @db.Uuid
  /// Immutable, cryptographically random, public identifier generated by
  /// packages/domain — never the internal `id` (CLAUDE.md).
  publicId         String            @unique @db.VarChar(32)
  sku              String            @unique @db.VarChar(64)
  categoryId       String            @db.Uuid
  status           PublicationStatus @default(DRAFT)
  publishedAt      DateTime?
  /// Durable, one-way "permanently retired" state — see Content.retiredAt.
  retiredAt        DateTime?
  retirementReason String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  translations ProductTranslation[]
  orderLines   OrderLine[]
  assets       ProductAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(0)

  @@index([categoryId, status])
  @@map("products")
}

model ProductTranslation {
  id             String  @id @default(uuid()) @db.Uuid
  productId      String  @db.Uuid
  locale         Locale
  name           String  @db.VarChar(255)
  /// Localized slug; the canonical product URL is
  /// `/{locale}/catalog/{publicId}-{slug}` — resolution is always by
  /// publicId, a stale slug here 308-redirects rather than 404s, so slug is
  /// not itself part of a uniqueness constraint (ADR-0010).
  slug           String  @db.VarChar(180)
  description    String?
  seoTitle       String? @db.VarChar(255)
  seoDescription String? @db.VarChar(500)

  /// Non-binding "from" price — see ADR-0005. currency is required whenever
  /// priceFromMinor is set, enforced by a CHECK constraint in migration.sql
  /// (`product_translation_price_currency_pair`).
  priceFromMinor  Int?
  currency        String?          @db.Char(3)
  priceMode       PriceDisplayMode @default(FROM_PRICE_INDICATIVE)
  priceDisclaimer String?          @db.VarChar(120)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Backs optimistic concurrency for the translation-edit use case — see
  /// the matching comment on ContentTranslation.version.
  version   Int      @default(0)

  @@unique([productId, locale])
  @@index([locale, slug])
  @@map("product_translations")
}

/// Product image/document attachment (Phase 6 media/documents deliverable).
/// Binary content lives only in the StorageProvider (packages/application/
/// src/ports.ts); this table is metadata only (CLAUDE.md: "Keep file
/// metadata separate from binary storage"). `storageKey` is always a
/// generated, opaque value — never the caller-supplied `originalFilename`
/// or any derivative of it that could traverse a path (see uploadProductAsset,
/// packages/application/src/product-assets.ts).
model ProductAsset {
  id        String            @id @default(uuid()) @db.Uuid
  productId String            @db.Uuid
  assetType ProductAssetType
  /// DRAFT assets are visible only in the admin UI; PUBLISHED assets render
  /// on the public product page; ARCHIVED is a soft-remove that keeps the
  /// audit/outbox trail intact instead of a hard delete.
  status    PublicationStatus @default(DRAFT)

  storageKey       String @unique @db.VarChar(255)
  originalFilename String @db.VarChar(255)
  /// Editorial display name — distinct from originalFilename, never used to
  /// build a storage path (CLAUDE.md: "Never use a user-supplied filename or
  /// path as a storage path").
  displayName      String @db.VarChar(255)
  contentType      String @db.VarChar(120)
  /// CHECK (sizeBytes > 0) added in migration.sql (`product_asset_size_positive`).
  sizeBytes        Int
  checksumSha256   String @db.Char(64)

  /// Null when the asset applies to every locale (e.g. a language-neutral
  /// diagram); set when alt text/caption is locale-specific (DB-007/DB-008
  /// translation-per-locale convention extended to assets).
  locale  Locale?
  altText String? @db.VarChar(255)
  caption String? @db.VarChar(500)

  /// CHECK (sortOrder >= 0) added in migration.sql (`product_asset_sort_order_non_negative`).
  sortOrder Int @default(0)

  malwareScanStatus MalwareScanStatus
  /// Free-text scan-engine identity, always populated and always honest
  /// about provenance (CLAUDE.md: "do not falsely claim files were
  /// scanned") — e.g. "dev-stub (not production-grade; ADR-0006 pending)"
  /// until a real scanner is wired.
  malwareScanEngine String            @db.VarChar(160)

  uploadedByUserId String? @db.Uuid

  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadedByUser User?   @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(0)

  @@index([productId, assetType, status, sortOrder])
  @@map("product_assets")
}

// ---------- Ordering ----------

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  /// Public, immutable order reference used in
  /// /{locale}/account/orders/{orderNumber}; generated by packages/domain.
  orderNumber     String      @unique @db.VarChar(32)
  companyId       String      @db.Uuid
  createdByUserId String      @db.Uuid
  status          OrderStatus @default(DRAFT)

  contactName     String? @db.VarChar(255)
  contactPhone    String? @db.VarChar(32)
  contactEmail    String? @db.VarChar(320)
  deliveryAddress Json?

  /// Idempotency-Key for the submit-order use case (Phase 5); unset while
  /// still DRAFT.
  idempotencyKey String?   @unique @db.VarChar(128)
  submittedAt    DateTime?

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdByUser User                 @relation("OrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines         OrderLine[]
  statusHistory OrderStatusHistory[]
  comments      OrderComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(0)

  @@index([companyId, status])
  @@map("orders")
}

model OrderLine {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @db.Uuid
  productId String @db.Uuid

  /// Snapshotted at the time the line is added so catalog edits never change
  /// an existing order line (CLAUDE.md). No price/tax/total column — see
  /// ADR-0005 (quote-only).
  productNameSnapshot String @db.VarChar(255)
  productSkuSnapshot  String @db.VarChar(64)

  /// CHECK (quantity > 0) added in migration.sql (`order_line_quantity_positive`).
  quantity Int
  note     String? @db.VarChar(500)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@map("order_lines")
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?      @db.Uuid
  reason      String?      @db.VarChar(500)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// ORD-008/ACC-004/TZ §6.6: order-scoped comments. PUBLIC is visible to the
/// ordering company's own members; INTERNAL only to order.transition holders
/// (manager/admin) — see packages/application/src/order-comments.ts. Never
/// edited/deleted (append-only, matching OrderStatusHistory's convention).
model OrderComment {
  id         String            @id @default(uuid()) @db.Uuid
  orderId    String            @db.Uuid
  authorId   String            @db.Uuid
  visibility CommentVisibility
  body       String            @db.VarChar(2000)

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User  @relation("OrderCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_comments")
}

// ---------- Audit & outbox ----------

model AuditEvent {
  id          String  @id @default(uuid()) @db.Uuid
  actorUserId String? @db.Uuid
  action      String  @db.VarChar(120)
  entityType  String  @db.VarChar(80)
  entityId    String  @db.VarChar(80)
  metadata    Json?
  /// W3C trace id correlation (CLAUDE.md observability policy); no PII or
  /// secrets are stored here.
  traceId     String? @db.VarChar(64)

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

model OutboxMessage {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @db.VarChar(80)
  aggregateId   String       @db.VarChar(80)
  eventType     String       @db.VarChar(120)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt])
  @@map("outbox_messages")
}

// ---------- Product Owner / admin control plane (CLAUDE.md "Public URL and
// localization policy" + docs/runbooks/search-visibility.md "Settings,
// controls and recovery") ----------

/// Single-row policy table (the `id` default enforces one well-known row by
/// application-layer convention — Prisma has no first-class "singleton table"
/// constraint, same pragmatic approach this schema already uses for other
/// not-yet-fully-modeled concerns, e.g. Company.metadata). Every field maps
/// directly to a named row in the search-visibility runbook's settings table;
/// no field here is speculative. Secrets (IndexNow API key, any future OAuth
/// token) are never columns on this table — only a non-secret public
/// verification token or a boolean "configured" flag is stored; the real
/// secret lives in the deployment secret store per CLAUDE.md.
model PlatformSettings {
  id String @id @default("singleton")

  // Canonical host, HTTPS/host redirect and trailing-slash policy.
  canonicalHost      String  @db.VarChar(255)
  forceHttps         Boolean @default(true)
  stripTrailingSlash Boolean @default(true)

  // Organization/NAP facts — published in Organization JSON-LD only when
  // set; automation never fabricates these (CLAUDE.md: "only when real and
  // maintained").
  organizationName      String?
  organizationLegalName String?
  organizationEmail     String?
  organizationPhone     String?
  organizationAddress   String?
  /// JSON array of verified social/profile URLs (schema.org `sameAs`).
  organizationSameAs    Json?

  // Page-type SEO defaults / Open Graph fallback.
  seoDefaultTitleTemplate       String?
  seoDefaultDescriptionFallback String?
  ogFallbackImageUrl            String?

  // Crawler/snippet directives and experimental-file gate.
  /// Emergency disable: forces sitewide noindex regardless of per-entity
  /// publication state. Never deletes routes or bypasses publication rules.
  crawlerGlobalNoindex        Boolean @default(false)
  googleExtendedAllowed       Boolean @default(true)
  aiCompatibilityFilesEnabled Boolean @default(false)

  // Analytics consent mode and provider identifiers (non-secret IDs only).
  analyticsConsentRequired Boolean @default(true)
  ga4Enabled               Boolean @default(false)
  ga4MeasurementId         String?
  yandexMetricaEnabled     Boolean @default(false)
  yandexMetricaCounterId   String?
  /// Must stay false until the Rust analytics service's contract lands
  /// (not expected before October 2026 — search-visibility.md). The flag
  /// exists so the disabled-by-default adapter boundary has somewhere to
  /// read its enablement state from; flipping it true does not by itself
  /// make the (not-yet-implemented) adapter do anything.
  rustAnalyticsEnabled     Boolean @default(false)

  // Search Console / Yandex Webmaster / Bing / IndexNow integration state.
  // Verification tokens are public HTML-meta/DNS values, not secrets.
  searchConsoleVerificationToken   String?
  yandexWebmasterVerificationToken String?
  bingVerificationToken            String?
  /// The real IndexNow key is an env-configured deployment secret
  /// (never a column here); this only toggles whether the adapter is armed.
  indexNowEnabled                  Boolean @default(false)

  /// Kill switch for a future direct-sale/Merchant mode. Validated false at
  /// the application layer until a real versioned Offer model exists —
  /// CLAUDE.md: "do not enable Merchant output for current quote-only
  /// products."
  merchantCenterEnabled Boolean @default(false)

  updatedByUserId String?                   @db.Uuid
  history         PlatformSettingsHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(0)

  @@map("platform_settings")
}

/// Append-only audit/rollback trail: one row per committed settings change,
/// storing the full snapshot *before* the change plus who/why. Rollback is
/// implemented at the application layer as "apply a past snapshot as a new
/// update", never as a destructive rewrite of this table.
model PlatformSettingsHistory {
  id               String  @id @default(uuid()) @db.Uuid
  settingsId       String  @default("singleton")
  /// The settings row's `version` immediately before this change.
  previousVersion  Int
  /// Full settings snapshot as it was before this change (secrets are never
  /// stored here in the first place, so no redaction is needed on read).
  previousSnapshot Json
  changeReason     String?
  changedByUserId  String? @db.Uuid

  settings      PlatformSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  changedByUser User?            @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([settingsId, createdAt])
  @@map("platform_settings_history")
}

// ---------- Advertising-integration control plane (CLAUDE.md's named
// allowlist: Google Ads, Yandex Direct, Microsoft Ads, Meta, LinkedIn,
// TikTok — "future providers" means growing this enum, never accepting an
// arbitrary caller-chosen name) ----------

enum AdvertisingProvider {
  GOOGLE_ADS
  YANDEX_DIRECT
  MICROSOFT_ADS
  META
  LINKEDIN
  TIKTOK
}

enum ConsentCategory {
  ANALYTICS
  ADVERTISING
}

/// One row per AdvertisingProvider, seeded disabled by default (prisma/
/// seed.ts) — never implicitly materialized for an unknown provider.
/// `credentialSecretRef` is the *name* of a deployment-secret-store entry,
/// never a credential value (CLAUDE.md: "credentials are secret-store
/// references only"). No column here can carry a script/HTML/token value —
/// this table cannot itself become an arbitrary-JavaScript-injection vector.
model AdvertisingProviderConfig {
  id                  String              @id @default(uuid()) @db.Uuid
  provider            AdvertisingProvider @unique
  enabled             Boolean             @default(false)
  consentCategory     ConsentCategory     @default(ADVERTISING)
  accountId           String?
  containerId         String?
  pixelId             String?
  credentialSecretRef String?
  /// Provider-side test/sandbox mode — defaults true so a newly configured
  /// integration never sends live conversion data until explicitly
  /// promoted (a deliberate, audited second step, not this flag alone).
  testMode            Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(0)

  @@map("advertising_provider_configs")
}
