# Copy to .env and fill in real values. Never commit .env (see .gitignore).

# apps/web, apps/worker (packages/infrastructure/src/env.ts)
NODE_ENV=development
PORT=3000

# packages/infrastructure Prisma connection (prisma.config.ts, src/prisma-client.ts).
# Matches infra/docker/docker-compose.yml's local-dev-only credentials; use a
# real secret in staging/production, never this value.
DATABASE_URL=postgresql://eramix:eramix_local_dev@localhost:5432/eramix
