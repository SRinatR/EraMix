# Copy to .env and fill in real values. Never commit .env (see .gitignore).
#
# Local dev/test scripts (`pnpm --filter web run dev`, `db:seed`,
# `db:migrate:dev`, etc.) load this file automatically via a dotenvx CLI
# wrapper (see docs/adr/0016-dotenvx-environment-workflow.md) — nothing in
# this repository's own code imports dotenv/dotenvx. CI, Docker, and the Pi
# scripts (scripts/pi/*.sh) never read this file; they set real values
# directly as ambient environment variables, which always take precedence
# over anything here.

# apps/web, apps/worker (packages/infrastructure/src/env.ts)
NODE_ENV=development
PORT=3000

# packages/infrastructure Prisma connection (prisma.config.ts, src/prisma-client.ts).
# Matches infra/docker/docker-compose.yml's local-dev-only credentials; use a
# real secret in staging/production, never this value.
DATABASE_URL=postgresql://eramix:eramix_local_dev@localhost:5432/eramix

# --- OIDC Authorization Code + PKCE (apps/web/src/app/api/auth/*) ---
# All optional: the real ODS issuer/client contract is blocked on Q-01/
# ADR-0003. The app boots fine without these (catalog/content/health still
# work); only /api/auth/* fails closed until they're set. Never invent an
# ODS value here — leave unset until the real integration pack arrives.
# OIDC_ISSUER_URL=https://issuer.example.invalid
# OIDC_CLIENT_ID=eramix-web
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Signs the stateless session cookie and the pending-auth (PKCE) cookie
# (packages/infrastructure/src/oidc/session-codec.ts,
# pending-auth-codec.ts). Required only when /api/auth/* is used. Generate
# with e.g. `openssl rand -base64 32`; never reuse across environments.
# SESSION_SECRET=

# Absolute origin used to build absolute URLs (sitemap.xml, Open Graph,
# robots.txt). Falls back to a placeholder in dev when unset.
# PUBLIC_ORIGIN=https://eramix.example

# OTLP/HTTP traces endpoint (packages/infrastructure/src/telemetry.ts).
# Tracing no-ops (does not start the SDK) when unset.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# --- Dev-only local media storage (apps/web/src/app/api/media/*, and
# product image/document attachments — apps/web/src/app/api/admin/products/
# {productId}/assets/*, packages/application/src/product-assets.ts) ---
# The real S3-compatible provider is blocked on Q-06/ADR-0006; this is a
# local-disk stand-in only (packages/infrastructure/src/
# local-storage-provider.ts) — never use in production.
MEDIA_STORAGE_DIR=.var/media
# Signs download URLs (HMAC). Required only when /api/media/* or product
# asset uploads/downloads are used, and only for the local-storage fallback
# (unused when R2_* below is fully configured).
# MEDIA_SIGNING_SECRET=

# --- Cloudflare R2 (S3-compatible) production object storage (ADR-0006,
# Accepted) — apps/web/src/server/container.ts's `storage` getter. All four
# must be set together (or all left unset to use the local-disk fallback
# above). Obtain real values from the Cloudflare R2 dashboard; never invent
# them here.
# R2_ACCOUNT_ID=
# R2_BUCKET=eramix-media-prod
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- IndexNow (apps/worker's outbox dispatch; apps/web's
# /api/seo/indexnow-key.txt verification file) ---
# P1, Bing/Yandex-only notification adapter (CLAUDE.md) — never a Google
# indexing mechanism. Optional: submission only happens when this AND the
# admin-controlled PlatformSettings.indexNowEnabled kill switch are both
# set. Obtain a real key from https://www.bing.com/indexnow; never invent
# one here.
# INDEXNOW_KEY=

# --- GA4 Measurement Protocol (apps/worker's analytics event dispatch) ---
# A real credential — never the non-secret PlatformSettings.ga4MeasurementId.
# Dispatch only happens when this, PlatformSettings.ga4Enabled, and a
# per-event analytics consent grant all agree.
# GA4_API_SECRET=
